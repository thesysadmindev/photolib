# Postgres
DATABASE_URL=postgres://photolib:changeme@localhost:5432/photolib

# Redis (BullMQ + rate limiting)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=photolib
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Site title shown in the header nav (defaults to "Photo Library" if unset)
SITE_TITLE=Photo Library

# Admin seed (used by the db:seed-admin script, not read at runtime)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=changeme

# Internal watermark sidecar (localhost only, never exposed publicly)
WATERMARK_SVC_URL=http://127.0.0.1:8000

# Worker
DARKTABLE_TIMEOUT_MS=120000
WORKER_SCRATCH_DIR=/tmp/photolib

# Upload limits
MAX_UPLOAD_SIZE_MB=100
